{
  "format_version": 1,
  "artifact": "project-orchestrator-registry",
  "status_values": [
    "ACTIVE",
    "PAUSED",
    "HANDOFF_PENDING",
    "RETIRED"
  ],
  "rules": {
    "maximum_active_orchestrators": 1,
    "maximum_repository_writers": 1,
    "writer_requires_exact_authorization_reference": true,
    "status_or_role_grants_write_authority": false,
    "runtime_monitoring": false,
    "heartbeats": false,
    "automatic_conversation_creation": false,
    "automatic_authority_transfer": false,
    "private_conversation_inspection": false,
    "hidden_context_inference": false
  },
  "project_checkpoint": {
    "repository": "{{PROJECT_REPOSITORY}}",
    "branch": "{{CONTROLLED_BRANCH}}",
    "worktree": "{{CONTROLLED_WORKTREE}}",
    "checkpoint": "{{EXACT_COMMIT_SHA}}"
  },
  "current_assignments": {
    "current_orchestrator": "PROJECT_ORCHESTRATOR",
    "current_section_working_model": null,
    "repository_writer": null,
    "writer_authorization_reference": null
  },
  "orchestrators": [
    {
      "id": "PROJECT_ORCHESTRATOR",
      "role": "PROJECT_ORCHESTRATOR",
      "status": "PAUSED",
      "reports_to": "ADMINISTRATOR",
      "current_section_working_model_reports_to": "PROJECT_ORCHESTRATOR"
    }
  ]
}
