{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:floppy-project-interaction-system:schema:bce-official-project-plan:2.0.0",
  "title": "Floppy V2 Official Project Plan",
  "description": "V2-05 normative accepted Official Project Plan. $defs.review_candidate is pre-acceptance only and intentionally invalid at the accepted root.",
  "status": "normative",
  "schema_version": "2.0.0",
  "owner": "V2-05",
  "production_enforcement": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "contract_version",
    "plan_id",
    "plan_revision_id",
    "project_id",
    "accepted_state_revision_id",
    "project_identity",
    "intended_observable_final_outcome",
    "accepted_scope",
    "accepted_exclusions",
    "major_constraints",
    "verified_starting_state",
    "important_assumptions",
    "known_unknowns",
    "accepted_architectural_decisions",
    "section_roadmap",
    "deferred_work",
    "explicitly_rejected_work",
    "migration_deployment_considerations",
    "project_level_risks",
    "authority_model",
    "first_proposed_work_section",
    "roadmap_binding",
    "project_origin_binding",
    "source_provenance",
    "acceptance",
    "revision"
  ],
  "properties": {
    "format": {
      "const": "floppy-official-project-plan"
    },
    "format_version": {
      "const": "1.0.0"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^OPP-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "plan_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "accepted_state_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "project_identity": {
      "$ref": "#/$defs/project_identity"
    },
    "intended_observable_final_outcome": {
      "type": "string",
      "minLength": 1
    },
    "accepted_scope": {
      "$ref": "#/$defs/accepted_scope"
    },
    "accepted_exclusions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "major_constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/major_constraint"
      }
    },
    "verified_starting_state": {
      "$ref": "#/$defs/verified_starting_state"
    },
    "important_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/known_unknown"
      }
    },
    "accepted_architectural_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/architectural_decision"
      }
    },
    "section_roadmap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/section_roadmap_entry"
      }
    },
    "deferred_work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deferred_work_item"
      }
    },
    "explicitly_rejected_work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rejected_work_item"
      }
    },
    "migration_deployment_considerations": {
      "$ref": "#/$defs/migration_deployment_considerations"
    },
    "project_level_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project_risk"
      }
    },
    "authority_model": {
      "$ref": "#/$defs/authority_model"
    },
    "first_proposed_work_section": {
      "$ref": "#/$defs/first_proposed_work_section"
    },
    "roadmap_binding": {
      "$ref": "#/$defs/roadmap_binding"
    },
    "project_origin_binding": {
      "$ref": "#/$defs/project_origin_binding"
    },
    "source_provenance": {
      "$ref": "#/$defs/source_provenance"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "revision": {
      "$ref": "#/$defs/revision"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "project_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_name",
        "project_summary",
        "project_type",
        "canonical_repository",
        "canonical_branch",
        "existing_project",
        "existing_floppy_project"
      ],
      "properties": {
        "project_name": {
          "type": "string",
          "minLength": 1
        },
        "project_summary": {
          "type": "string",
          "minLength": 1
        },
        "project_type": {
          "type": "string",
          "minLength": 1
        },
        "canonical_repository": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "canonical_branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "existing_project": {
          "type": "boolean"
        },
        "existing_floppy_project": {
          "type": "boolean"
        }
      }
    },
    "accepted_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcomes",
        "capabilities",
        "boundaries"
      ],
      "properties": {
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "major_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "statement",
        "source",
        "change_requires_plan_revision"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": [
            "ADMINISTRATOR",
            "VERIFIED_PROJECT_STATE",
            "EXTERNAL_REQUIREMENT",
            "TECHNICAL_REQUIREMENT"
          ]
        },
        "change_requires_plan_revision": {
          "const": true
        }
      }
    },
    "repository_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "commit",
        "tree"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "tree": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "starting_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "REPOSITORY_CHECKPOINT",
            "FILE",
            "ADMINISTRATOR_STATEMENT",
            "EXTERNAL_EVIDENCE",
            "VERIFIED_OBSERVATION"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verified_starting_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "repository_checkpoint",
        "evidence"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "repository_checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/repository_checkpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/starting_evidence"
          }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "statement",
        "basis",
        "impact_if_false",
        "status"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "impact_if_false": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "ACCEPTED_ASSUMPTION"
        }
      }
    },
    "known_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_id",
        "statement",
        "resolution_boundary",
        "dependent_section_id",
        "blocks_plan_acceptance"
      ],
      "properties": {
        "unknown_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "resolution_boundary": {
          "enum": [
            "BEFORE_FIRST_SECTION_ACCEPTANCE",
            "BEFORE_DEPENDENT_SECTION",
            "BEFORE_PROJECT_RELEASE",
            "MAY_REMAIN_OPEN"
          ]
        },
        "dependent_section_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "blocks_plan_acceptance": {
          "const": false
        }
      }
    },
    "architectural_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision",
        "rationale",
        "applies_to",
        "change_requires_plan_revision"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "change_requires_plan_revision": {
          "const": true
        }
      }
    },
    "section_roadmap_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "name",
        "purpose",
        "observable_outcome",
        "dependencies",
        "acceptance_evidence",
        "status",
        "implementation_details_frozen"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "observable_outcome": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptance_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "DRAFT_NOT_AUTHORIZED",
            "PLANNED_NOT_AUTHORIZED"
          ]
        },
        "implementation_details_frozen": {
          "const": false
        }
      }
    },
    "deferred_work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "statement",
        "reason",
        "revisit_condition"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "revisit_condition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "rejected_work_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "statement",
        "rationale"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "migration_deployment_considerations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "migration_disposition",
        "automatic_migration",
        "migration_authority",
        "deployment_disposition",
        "deployment_notes",
        "deployment_or_release_grants_implementation_authority"
      ],
      "properties": {
        "migration_disposition": {
          "enum": [
            "NONE",
            "POTENTIAL_REQUIRES_SEPARATE_AUTHORITY",
            "REQUIRED_REQUIRES_SEPARATE_AUTHORITY"
          ]
        },
        "automatic_migration": {
          "const": false
        },
        "migration_authority": {
          "const": "SEPARATE_EXPLICIT_ADMINISTRATOR_AUTHORITY_REQUIRED"
        },
        "deployment_disposition": {
          "enum": [
            "NONE",
            "PLANNED",
            "EXTERNAL"
          ]
        },
        "deployment_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deployment_or_release_grants_implementation_authority": {
          "const": false
        }
      }
    },
    "project_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_id",
        "risk",
        "impact",
        "mitigation",
        "status"
      ],
      "properties": {
        "risk_id": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "mitigation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "OPEN",
            "MITIGATED",
            "ACCEPTED",
            "DEFERRED"
          ]
        }
      }
    },
    "authority_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "administrator_final_authority",
        "plan_acceptance_grants_implementation_authority",
        "plan_acceptance_grants_repository_writer",
        "plan_acceptance_grants_migration_authority",
        "plan_acceptance_grants_main_modification_authority",
        "plan_acceptance_grants_integration_authority",
        "plan_acceptance_grants_tag_authority",
        "plan_acceptance_grants_release_authority",
        "role_or_provider_capability_grants_authority",
        "automatic_authority_transfer",
        "implementation_authorization",
        "first_section_requires_separate_work_package_acceptance"
      ],
      "properties": {
        "administrator_final_authority": {
          "const": true
        },
        "plan_acceptance_grants_implementation_authority": {
          "const": false
        },
        "plan_acceptance_grants_repository_writer": {
          "const": false
        },
        "plan_acceptance_grants_migration_authority": {
          "const": false
        },
        "plan_acceptance_grants_main_modification_authority": {
          "const": false
        },
        "plan_acceptance_grants_integration_authority": {
          "const": false
        },
        "plan_acceptance_grants_tag_authority": {
          "const": false
        },
        "plan_acceptance_grants_release_authority": {
          "const": false
        },
        "role_or_provider_capability_grants_authority": {
          "const": false
        },
        "automatic_authority_transfer": {
          "const": false
        },
        "implementation_authorization": {
          "const": "SEPARATE_EXPLICIT_ACTION_REQUIRED"
        },
        "first_section_requires_separate_work_package_acceptance": {
          "const": true
        }
      }
    },
    "first_proposed_work_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section_id",
        "draft_path",
        "status",
        "work_package_acceptance",
        "implementation",
        "verification",
        "implementation_authorization",
        "section_working_model",
        "repository_writer"
      ],
      "properties": {
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "draft_path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "DRAFT_NOT_AUTHORIZED"
        },
        "work_package_acceptance": {
          "const": "NOT_ACCEPTED"
        },
        "implementation": {
          "const": "NOT_STARTED"
        },
        "verification": {
          "const": "NOT_STARTED"
        },
        "implementation_authorization": {
          "type": "null"
        },
        "section_working_model": {
          "type": "null"
        },
        "repository_writer": {
          "type": "null"
        }
      }
    },
    "roadmap_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "machine_path",
        "human_path",
        "machine_sha256",
        "human_sha256",
        "section_roadmap_sha256"
      ],
      "properties": {
        "machine_path": {
          "const": ".floppy/roadmap/roadmap.json"
        },
        "human_path": {
          "const": ".floppy/roadmap/roadmap.md"
        },
        "machine_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "human_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "section_roadmap_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "project_origin_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin_contract",
        "project_id",
        "accepted_state_path",
        "accepted_state_revision_id",
        "continuity_overseer_id",
        "initial_project_orchestrator_id",
        "shared_origin_linkage"
      ],
      "properties": {
        "origin_contract": {
          "const": "V2_ACCEPTED_PROJECT_ORIGIN"
        },
        "project_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "accepted_state_path": {
          "const": ".floppy/accepted-state.json"
        },
        "accepted_state_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "continuity_overseer_id": {
          "type": "string",
          "pattern": "^CO-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "initial_project_orchestrator_id": {
          "type": "string",
          "pattern": "^ORCH-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}-00000001$"
        },
        "shared_origin_linkage": {
          "const": "DERIVED_AFTER_ACCEPTED_STATE_ESTABLISHMENT"
        }
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floppy_source_identity",
        "compatibility_profile",
        "onboarding_entrypoint",
        "review_candidate_substantive_sha256",
        "provider_capability_class",
        "generation_repository_checkpoint"
      ],
      "properties": {
        "floppy_source_identity": {
          "const": "2.0.0"
        },
        "compatibility_profile": {
          "const": "2.0.0"
        },
        "onboarding_entrypoint": {
          "const": "onboarding/Floppy_1E.md"
        },
        "review_candidate_substantive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provider_capability_class": {
          "enum": [
            "CLASS_A",
            "CLASS_B",
            "CLASS_C"
          ]
        },
        "generation_repository_checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority",
        "accepted_at",
        "decision",
        "review_candidate_substantive_sha256"
      ],
      "properties": {
        "status": {
          "const": "ACCEPTED"
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "accepted_at": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "review_candidate_substantive_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision_id",
        "revision_kind",
        "supersedes_revision_id",
        "review_candidate_substantive_sha256",
        "substantive_projection_sha256",
        "mechanical_completion_verified",
        "canonical_machine_path",
        "canonical_human_path",
        "active_machine_alias",
        "active_human_alias",
        "active_alias_semantics"
      ],
      "properties": {
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_kind": {
          "enum": [
            "ORIGINAL",
            "LAWFUL_REVISION"
          ]
        },
        "supersedes_revision_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "review_candidate_substantive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "substantive_projection_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "mechanical_completion_verified": {
          "const": true
        },
        "canonical_machine_path": {
          "type": "string",
          "minLength": 1
        },
        "canonical_human_path": {
          "type": "string",
          "minLength": 1
        },
        "active_machine_alias": {
          "const": ".floppy/project-plan/official-project-plan.json"
        },
        "active_human_alias": {
          "const": ".floppy/project-plan/official-project-plan.md"
        },
        "active_alias_semantics": {
          "const": "MUTABLE_POINTER_COPY_TO_CURRENT_ACCEPTED_REVISION"
        }
      }
    },
    "substantive_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_identity",
        "intended_observable_final_outcome",
        "accepted_scope",
        "accepted_exclusions",
        "major_constraints",
        "verified_starting_state",
        "important_assumptions",
        "known_unknowns",
        "accepted_architectural_decisions",
        "section_roadmap",
        "deferred_work",
        "explicitly_rejected_work",
        "migration_deployment_considerations",
        "project_level_risks",
        "authority_model",
        "first_proposed_work_section"
      ],
      "properties": {
        "project_identity": {
          "$ref": "#/$defs/project_identity"
        },
        "intended_observable_final_outcome": {
          "type": "string",
          "minLength": 1
        },
        "accepted_scope": {
          "$ref": "#/$defs/accepted_scope"
        },
        "accepted_exclusions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "major_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/major_constraint"
          }
        },
        "verified_starting_state": {
          "$ref": "#/$defs/verified_starting_state"
        },
        "important_assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumption"
          }
        },
        "known_unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/known_unknown"
          }
        },
        "accepted_architectural_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/architectural_decision"
          }
        },
        "section_roadmap": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section_roadmap_entry"
          }
        },
        "deferred_work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deferred_work_item"
          }
        },
        "explicitly_rejected_work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejected_work_item"
          }
        },
        "migration_deployment_considerations": {
          "$ref": "#/$defs/migration_deployment_considerations"
        },
        "project_level_risks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project_risk"
          }
        },
        "authority_model": {
          "$ref": "#/$defs/authority_model"
        },
        "first_proposed_work_section": {
          "$ref": "#/$defs/first_proposed_work_section"
        }
      }
    },
    "review_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_format",
        "candidate_format_version",
        "substantive_plan"
      ],
      "properties": {
        "candidate_format": {
          "const": "floppy-official-project-plan-review-candidate"
        },
        "candidate_format_version": {
          "const": "1.0.0"
        },
        "substantive_plan": {
          "$ref": "#/$defs/substantive_plan"
        }
      }
    }
