{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:floppy-project-interaction-system:schema:bce-lifecycle-state:1.1.0",
  "title": "Normative BCE Lifecycle State 1.1.0",
  "description": "CTRL-02 normative extension supporting verification-only lifecycle disposition without production enforcement.",
  "status": "normative",
  "schema_version": "1.1.0",
  "normative_section": "CTRL-02",
  "production_enforcement": false,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_package_type",
    "state_id",
    "dimensions",
    "active_implementation_sections"
  ],
  "properties": {
    "state_id": {
      "$ref": "#/$defs/lifecycle_state_identifier"
    },
    "section": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^FS-[0-9]{2}$"
    },
    "authorization_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "base_checkpoint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "dimensions": {
      "$ref": "#/$defs/lifecycle_dimensions"
    },
    "active_implementation_sections": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/section_identifier"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/non_empty_string"
      },
      "uniqueItems": true
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "work_package_type": {
      "type": "string",
      "enum": [
        "STANDARD_IMPLEMENTATION",
        "VERIFICATION_ONLY_NO_REUSABLE_PRODUCT_CHANGE"
      ]
    }
  },
  "$defs": {
    "non_empty_string": {
      "type": "string",
      "minLength": 1
    },
    "section_identifier": {
      "type": "string",
      "pattern": "^FS-[0-9]{2}$"
    },
    "lifecycle_state_identifier": {
      "type": "string",
      "enum": [
        "LC-ONBOARDING-REQUIRED",
        "LC-ROADMAP-ACCEPTED-NO-ACTIVE-WORK",
        "LC-WORK-PACKAGE-ACCEPTED-NO-ACTIVE-WORK",
        "LC-SECTION-AUTHORIZED-NOT-STARTED",
        "LC-SECTION-IMPLEMENTATION-IN-PROGRESS",
        "LC-IMPLEMENTATION-COMPLETE-VERIFICATION-PENDING",
        "LC-VERIFICATION-COMPLETE-ACCEPTANCE-PENDING",
        "LC-SECTION-ACCEPTED-CLOSEOUT-NOT-PROPOSED",
        "LC-SECTION-ACCEPTED-CLOSEOUT-PROPOSED",
        "LC-SECTION-CLOSED-NEXT-SECTION-INACTIVE",
        "LC-MIGRATION-PLANNED-NOT-AUTHORIZED",
        "LC-MIGRATION-AUTHORIZED-NOT-APPLIED",
        "LC-MIGRATION-APPLIED-VERIFICATION-PENDING",
        "LC-MIGRATION-APPLIED-VERIFICATION-COMPLETE",
        "LC-PROJECT-CLOSURE-PROPOSED",
        "LC-PROJECT-FINALLY-CLOSED",
        "LC-VERIFICATION-ONLY-WORK-PACKAGE-ACCEPTED-PENDING",
        "LC-VERIFICATION-ONLY-COMPLETE-ACCEPTANCE-PENDING",
        "LC-VERIFICATION-ONLY-SECTION-ACCEPTED-CLOSEOUT-NOT-PROPOSED",
        "LC-VERIFICATION-ONLY-SECTION-ACCEPTED-CLOSEOUT-PROPOSED"
      ]
    },
    "roadmap_state": {
      "type": "string",
      "enum": [
        "ONBOARDING_REQUIRED",
        "ACCEPTED"
      ]
    },
    "work_package_state": {
      "type": "string",
      "enum": [
        "NOT_ACCEPTED",
        "ACCEPTED_PLANNING_BASELINE"
      ]
    },
    "authority_state": {
      "type": "string",
      "enum": [
        "NO_ACTIVE_WORK_AUTHORIZATION",
        "EXACT_SECTION_IMPLEMENTATION_AUTHORIZATION",
        "EXACT_MIGRATION_AUTHORIZATION"
      ]
    },
    "implementation_state": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "IN_PROGRESS",
        "COMPLETE",
        "NOT_REQUIRED"
      ]
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "NOT_STARTED",
        "PENDING",
        "COMPLETE",
        "FAILED"
      ]
    },
    "acceptance_state": {
      "type": "string",
      "enum": [
        "PENDING",
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "closeout_state": {
      "type": "string",
      "enum": [
        "NOT_PROPOSED",
        "PROPOSED",
        "APPLIED"
      ]
    },
    "migration_state": {
      "type": "string",
      "enum": [
        "NONE",
        "PLANNED_NOT_AUTHORIZED",
        "AUTHORIZED_NOT_APPLIED",
        "APPLIED_VERIFICATION_PENDING",
        "APPLIED_VERIFICATION_COMPLETE"
      ]
    },
    "final_closure_state": {
      "type": "string",
      "enum": [
        "OPEN",
        "PROPOSED",
        "FINALLY_CLOSED"
      ]
    },
    "lifecycle_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roadmap",
        "work_package",
        "authority",
        "implementation",
        "verification",
        "acceptance",
        "closeout",
        "migration",
        "final_closure"
      ],
      "properties": {
        "roadmap": {
          "$ref": "#/$defs/roadmap_state"
        },
        "work_package": {
          "$ref": "#/$defs/work_package_state"
        },
        "authority": {
          "$ref": "#/$defs/authority_state"
        },
        "implementation": {
          "$ref": "#/$defs/implementation_state"
        },
        "verification": {
          "$ref": "#/$defs/verification_state"
        },
        "acceptance": {
          "$ref": "#/$defs/acceptance_state"
        },
        "closeout": {
          "$ref": "#/$defs/closeout_state"
        },
        "migration": {
          "$ref": "#/$defs/migration_state"
        },
        "final_closure": {
          "$ref": "#/$defs/final_closure_state"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "work_package_type": {
            "const": "VERIFICATION_ONLY_NO_REUSABLE_PRODUCT_CHANGE"
          }
        },
        "required": [
          "work_package_type"
        ]
      },
      "then": {
        "properties": {
          "authorization_id": {
            "type": "null"
          },
          "active_implementation_sections": {
            "maxItems": 0
          },
          "dimensions": {
            "allOf": [
              {
                "properties": {
                  "authority": {
                    "const": "NO_ACTIVE_WORK_AUTHORIZATION"
                  },
                  "implementation": {
                    "const": "NOT_REQUIRED"
                  }
                },
                "required": [
                  "authority",
                  "implementation"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
